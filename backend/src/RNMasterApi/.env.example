# ==========================================
# DATABASE
# ==========================================
DB_CONNECTION=Server=YOUR_SERVER_NAME;Database=RNMasterDb;Trusted_Connection=True;TrustServerCertificate=True;

# ==========================================
# SUPER ADMIN
# ==========================================
ADMIN_EMAIL=admin@rnmaster.com
ADMIN_PASSWORD=CHANGE_ME

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET
JWT_ISSUER=RNMaster
JWT_AUDIENCE=RNMasterClient
JWT_EXPIRY_MINUTES=60

# ==========================================
# IDENTITY ROLES
# ==========================================
IDENTITY_ROLES=SuperAdmin,Admin,User

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=Information
EF_CORE_LOG_LEVEL=Warning